# ==============================================================================
# FinanceAI — Environment Variables
#
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
#
# SECURITY: every third-party PROVIDER key (Groq, Twelve Data, Tavily, NewsAPI,
# Reddit, Resend) is SERVER-ONLY and must NEVER use the NEXT_PUBLIC_ prefix —
# NEXT_PUBLIC_ values are compiled into the browser bundle and visible to anyone.
# Only non-secret values the browser legitimately needs (base URL, contact-form
# endpoint) keep the NEXT_PUBLIC_ prefix.
# ==============================================================================


# ── Database ───────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required) — PostgreSQL 16+
# The schema is managed by Drizzle: `npx drizzle-kit migrate` applies the
# committed migrations in ./drizzle/migrations (run once per environment).
# `docker compose up -d financeai-db` starts a matching local database.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>


# ── Authentication (NextAuth) ──────────────────────────────────────────────────

# Random secret used to sign session tokens (required)
# Generate one: openssl rand -base64 32
NEXTAUTH_SECRET=

# Canonical URL of your deployment (required in production)
# Local dev: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth (optional — enables "Continue with GitHub")
# Create at https://github.com/settings/developers → OAuth Apps
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth (optional — enables "Continue with Google")
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── AI / LLM ───────────────────────────────────────────────────────────────────

# Groq API key (required for all AI advisor features) — SERVER-ONLY
# Get yours at https://console.groq.com/keys
# Legacy deployments may still have NEXT_PUBLIC_GROQ_API_KEY / NEXT_PUBLIC_GROK_API_KEY
# set; those are read server-side as a fallback but are deprecated and expose the
# key to the browser. Move the value to GROQ_API_KEY as soon as possible.
GROQ_API_KEY=

# Model overrides — change without redeploying (all optional, defaults shown)
GROQ_SMART_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_SMART_TEMPERATURE=0.7
GROQ_FAST_TEMPERATURE=0.3
GROQ_SMART_MAX_TOKENS=8192
GROQ_FAST_MAX_TOKENS=2048

# Conversation history token budget per request (optional, default 4000)
# Increase if users report "context too short" errors; decrease to save costs.
# Rule of thumb: 1 token ≈ 4 characters of text.
AI_HISTORY_TOKEN_BUDGET=4000


# ── Market Data ────────────────────────────────────────────────────────────────

# Twelve Data API key (required for stock/forex/crypto price & indicator data) — SERVER-ONLY
# Get yours at https://twelvedata.com/apikey  — free tier available
TWELVE_DATA_API_KEY=

# Optional pacing override for the Twelve Data free tier (ms between calls).
# Default 7600 (≈8 calls/min); set higher or lower to match your plan.
# TWELVEDATA_MIN_INTERVAL_MS=7600

# Eulerpool API key (Phase 1 second provider: canonical source for equity
# candles, company profiles, and fundamentals) — SERVER-ONLY
# Get yours at https://www.eulerpool.com — token is passed server-side only
EULERPOOL_API_KEY=

# Tavily API key (required for AI-powered market intelligence / web search) — SERVER-ONLY
# Get yours at https://app.tavily.com
TAVILY_API_KEY=

# NewsAPI key (required for the /api/news endpoint) — SERVER-ONLY
# Get yours at https://newsapi.org/register — free tier available
NEWS_API_KEY=

# Base URL used by server-side code to call its own API routes (optional)
# Defaults to http://localhost:3000 when unset
NEXT_PUBLIC_BASE_URL=http://localhost:3000


# ── Reddit Sentiment ───────────────────────────────────────────────────────────

# Reddit OAuth app credentials (required for social-sentiment features)
# Create at https://www.reddit.com/prefs/apps → script app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=


# ── Email ──────────────────────────────────────────────────────────────────────

# Resend API key (required for password-reset emails)
# Get yours at https://resend.com/api-keys — free tier: 100 emails/day
# If unset, reset emails are NOT sent and their contents are never logged
# (reset tokens are secrets). Set this key to exercise the reset flow locally.
RESEND_API_KEY=

# Sender address shown in outgoing emails (optional)
# Must be a domain verified in your Resend account.
EMAIL_FROM=FinanceAI <noreply@yourdomain.com>


# ── Dependency audit policy ───────────────────────────────────────────────────
#
# `npm audit --omit=dev --audit-level=high` (CI gate) currently reports 0
# vulnerabilities.  The weekly security-audit workflow reports the full audit
# surface (including devDependencies) — treat advisories there as informational
# unless the production gate starts failing.
#
# =============================================================================
