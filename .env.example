# ==============================================================================
# FinanceAI — Environment Variables
#
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle.
# Server-only secrets must NOT use the NEXT_PUBLIC_ prefix.
# ==============================================================================


# ── Database ───────────────────────────────────────────────────────────────────

# MongoDB connection string (required)
# Get yours from https://cloud.mongodb.com → Clusters → Connect
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority


# ── Authentication (NextAuth) ──────────────────────────────────────────────────

# Random secret used to sign session tokens (required)
# Generate one: openssl rand -base64 32
NEXTAUTH_SECRET=

# Canonical URL of your deployment (required in production)
# Local dev: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth (optional — enables "Continue with GitHub")
# Create at https://github.com/settings/developers → OAuth Apps
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth (optional — enables "Continue with Google")
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── AI / LLM ───────────────────────────────────────────────────────────────────

# Groq API key (required for all AI advisor features)
# Get yours at https://console.groq.com/keys
NEXT_PUBLIC_GROQ_API_KEY=

# Model overrides — change without redeploying (all optional, defaults shown)
GROQ_SMART_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_SMART_TEMPERATURE=0.7
GROQ_FAST_TEMPERATURE=0.3
GROQ_SMART_MAX_TOKENS=8192
GROQ_FAST_MAX_TOKENS=2048

# Conversation history token budget per request (optional, default 4000)
# Increase if users report "context too short" errors; decrease to save costs.
# Rule of thumb: 1 token ≈ 4 characters of text.
AI_HISTORY_TOKEN_BUDGET=4000


# ── Market Data ────────────────────────────────────────────────────────────────

# Twelve Data API key (required for stock/forex/crypto price & indicator data)
# Get yours at https://twelvedata.com/apikey  — free tier available
NEXT_PUBLIC_TWELVEDATA_API_KEY=

# Tavily API key (required for AI-powered market intelligence / web search)
# Get yours at https://app.tavily.com
NEXT_PUBLIC_TAVILY_API_KEY=

# NewsAPI key (required for the /api/news endpoint)
# Get yours at https://newsapi.org/register — free tier available
NEXT_PUBLIC_NEWS_API_KEY=

# Base URL used by server-side code to call its own API routes (optional)
# Defaults to http://localhost:3000 when unset
NEXT_PUBLIC_BASE_URL=http://localhost:3000


# ── Reddit Sentiment ───────────────────────────────────────────────────────────

# Reddit OAuth app credentials (required for social-sentiment features)
# Create at https://www.reddit.com/prefs/apps → script app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=


# ── Email ──────────────────────────────────────────────────────────────────────

# Resend API key (required for password-reset emails)
# Get yours at https://resend.com/api-keys — free tier: 100 emails/day
# If unset, reset tokens are logged to the server console instead (dev only).
RESEND_API_KEY=

# Sender address shown in outgoing emails (optional)
# Must be a domain verified in your Resend account.
EMAIL_FROM=FinanceAI <noreply@yourdomain.com>


# ── Known upstream vulnerabilities (informational — no action needed) ──────────
#
# undici (4 high-severity CVEs): bundled inside next@16.2.x — fix pending in
# Next.js 16.3.x.  Running `npm audit fix --force` would downgrade Next.js to
# 9.x which is far worse.  Track: https://github.com/vercel/next.js/issues
#
# =============================================================================
