{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // No baseUrl: since TypeScript 4.1 non-relative "paths" resolve relative to
    // this config's directory, so "@/*": ["../*"] already maps onto the repo
    // root (baseUrl was deprecated and errors under TypeScript 6).
    "paths": {
      "@/*": ["../*"]
    }
  },
  "include": ["verify-providers.ts", "verify-postgres.ts"]
}
